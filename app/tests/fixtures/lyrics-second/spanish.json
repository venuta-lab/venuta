    },
    {
      "start_ms": 5000,
      "end_ms": 9000,
      "text": "Tu sonrisa ilumina la ciudad",
      "words": [],
      "script": "Latn",
      "roman": null,
      "translation": {
        "text": "Your smile lights up the city",
        "words": [],
        "lang": "en",

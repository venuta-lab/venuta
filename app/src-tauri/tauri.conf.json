{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Venuta",
  "version": "0.1.0",
  "identifier": "app.venuta.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Venuta",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "windowEffects": {
          "effects": [
            "acrylic",
            "liquidGlassRegular",
            "hudWindow"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://*.scdn.co https://*.spotifycdn.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/Venuta/thumbs/**",
          "$DATA/Venuta/spectrograms/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Builds and keeps a perfect lossless music library, and syncs it to SD cards.",
    "category": "Music",
    "copyright": "© 2026 Venuta contributors. MIT License.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQTlDRjg4RTc5QjM2NTUKUldSVk5wdm5pTStwNDF6QXk5aThNVVJtWFRxT2RDWmpSVGFoOHlONHE4bGJhMUpLRXljOG5FOTYK",
      "endpoints": [
        "https://github.com/theSelfSa/venuta/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
